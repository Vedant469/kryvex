# SerpApi key — https://serpapi.com/manage-api-key
SERPAPI_KEY=your_serpapi_key_here

# Polygon Amoy testnet RPC — https://rpc-amoy.polygon.technology/
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology/

# Wallet private key (must hold Amoy MATIC for gas)
WALLET_PRIVATE_KEY=your_wallet_private_key_here

# Optional: reuse an already-deployed contract address (leave empty to auto-deploy)
CONTRACT_ADDRESS=
